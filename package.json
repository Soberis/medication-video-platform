{
  "name": "medication-video-platform",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "web:dev": "pnpm --filter @medication-video-platform/web dev",
    "web:lint": "pnpm --filter @medication-video-platform/web lint",
    "web:lint:fix": "pnpm --filter @medication-video-platform/web lint:fix",
    "web:format": "pnpm --filter @medication-video-platform/web format",
    "web:format:check": "pnpm --filter @medication-video-platform/web format:check",
    "web:type-check": "pnpm --filter @medication-video-platform/web type-check",
    "web:test": "pnpm --filter @medication-video-platform/web test",
    "web:build": "pnpm --filter @medication-video-platform/web build",
    "web:check": "pnpm run web:format:check && pnpm run web:lint && pnpm run web:type-check && pnpm run web:test && pnpm run web:build",
    "synthetic-upload": "node tools/synthetic-upload-client/index.mjs",
    "synthetic-upload:2gb": "node tools/synthetic-upload-client/large-upload-acceptance.mjs",
    "synthetic-upload:test": "node --test tools/synthetic-upload-client/*.test.mjs",
    "dataset-export:acceptance": "node tools/dataset-export-acceptance/index.mjs",
    "dataset-export:recovery-acceptance": "node tools/dataset-export-acceptance/index.mjs --recovery",
    "dataset-export:acceptance:test": "node --test tools/dataset-export-acceptance/*.test.mjs",
    "local-scripts:test": "node --test scripts/*.test.mjs",
    "contract:lint": "redocly lint contracts/openapi/openapi.yaml",
    "api:test": "node scripts/run-bruno.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.37.0",
    "@usebruno/cli": "3.5.2"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=11 <12"
  }
}
