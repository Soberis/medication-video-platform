{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.medication-video-platform.invalid/synchronized-frame-v1.schema.json",
  "title": "Canonical Synchronized Frame Slot V1",
  "description": "Logical row contract for one expected Camera at one Sync Frame. This freezes logical identity, nullability, states and provenance; Parquet compression, partitioning, row groups and writer settings remain outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "capture_group_key",
    "sync_revision_id",
    "sync_frame_index",
    "capture_timestamp_ns",
    "camera_number",
    "camera_stream_id",
    "video_id",
    "source_frame_index",
    "source_pts_ns",
    "source_pts_ordinal",
    "frame_state",
    "frame_reason_code",
    "sync_error_ns",
    "hand_detection_state",
    "ai_job_id",
    "candidate_count",
    "candidate_artifact_ref",
    "annotation_revision_id",
    "model_sha256",
    "profile_sha256",
    "artifact_created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "synchronized-frame.v1"
    },
    "capture_id": {
      "type": "string",
      "format": "uuid",
      "description": "Product alias of the existing capture_session_id; never a second Capture identity."
    },
    "capture_group_key": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "sync_revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "sync_frame_index": {
      "type": "integer",
      "minimum": 0
    },
    "capture_timestamp_ns": {
      "type": "integer",
      "minimum": 0,
      "description": "Integer exchange value calculated from the revision's exact rational timeline rule. The unit does not claim nanosecond source precision."
    },
    "camera_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "description": "Stable display number equal to the frozen CameraSetSnapshotMember.camera_index + 1."
    },
    "camera_stream_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "video_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Product alias of clip_asset_id; never a second Video identity."
    },
    "source_frame_index": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "source_pts_ns": {
      "type": ["integer", "null"],
      "description": "Normalized source PTS. The artifact manifest retains raw PTS, time base, origin and same-PTS ordinal."
    },
    "source_pts_ordinal": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "frame_state": {
      "type": "string",
      "enum": ["PRESENT", "MISSING", "INVALID"]
    },
    "frame_reason_code": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "sync_error_ns": {
      "type": ["integer", "null"],
      "description": "Signed mapped_capture_time(source_frame) minus target capture_timestamp_ns for a PRESENT mapping. The stream-to-Capture anchor/offset/drift mapping is frozen provenance."
    },
    "hand_detection_state": {
      "type": "string",
      "enum": ["HANDS_DETECTED", "NO_DETECTION", "FAILED", "NOT_RUN"]
    },
    "ai_job_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "candidate_artifact_ref": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 512,
      "description": "Logical reference only; never an object key or signed URL."
    },
    "annotation_revision_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Optional formal human revision actually projected into this artifact."
    },
    "model_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$",
      "description": "AI inference profile digest when inference ran; the synchronization profile digest belongs to artifact metadata."
    },
    "artifact_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "A frozen job timestamp shared by all rows; retries do not substitute wall-clock write time."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"frame_state": {"const": "PRESENT"}}
      },
      "then": {
        "properties": {
          "camera_stream_id": {"type": "string", "format": "uuid"},
          "video_id": {"type": "string", "format": "uuid"},
          "source_frame_index": {"type": "integer", "minimum": 0},
          "source_pts_ns": {"type": "integer"},
          "source_pts_ordinal": {"type": "integer", "minimum": 0},
          "frame_reason_code": {"type": "null"},
          "sync_error_ns": {"type": "integer"}
        }
      }
    },
    {
      "if": {
        "properties": {"frame_state": {"const": "MISSING"}}
      },
      "then": {
        "properties": {
          "source_frame_index": {"type": "null"},
          "source_pts_ns": {"type": "null"},
          "source_pts_ordinal": {"type": "null"},
          "frame_reason_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "sync_error_ns": {"type": "null"},
          "hand_detection_state": {"const": "NOT_RUN"}
        },
        "oneOf": [
          {
            "properties": {
              "camera_stream_id": {"type": "null"},
              "video_id": {"type": "null"}
            }
          },
          {
            "properties": {
              "camera_stream_id": {"type": "string", "format": "uuid"},
              "video_id": {"type": "string", "format": "uuid"}
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {"frame_state": {"const": "INVALID"}}
      },
      "then": {
        "properties": {
          "camera_stream_id": {"type": "string", "format": "uuid"},
          "video_id": {"type": "string", "format": "uuid"},
          "frame_reason_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "sync_error_ns": {"type": "null"},
          "hand_detection_state": {"const": "NOT_RUN"}
        }
      }
    },
    {
      "if": {
        "properties": {"hand_detection_state": {"const": "NOT_RUN"}}
      },
      "then": {
        "properties": {
          "ai_job_id": {"type": "null"},
          "candidate_count": {"const": 0},
          "candidate_artifact_ref": {"type": "null"},
          "model_sha256": {"type": "null"},
          "profile_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"hand_detection_state": {"const": "NO_DETECTION"}}
      },
      "then": {
        "properties": {
          "ai_job_id": {"type": "string", "format": "uuid"},
          "candidate_count": {"const": 0},
          "candidate_artifact_ref": {"type": "null"},
          "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    {
      "if": {
        "properties": {"hand_detection_state": {"const": "HANDS_DETECTED"}}
      },
      "then": {
        "properties": {
          "ai_job_id": {"type": "string", "format": "uuid"},
          "candidate_count": {"type": "integer", "minimum": 1, "maximum": 2},
          "candidate_artifact_ref": {"type": "string", "minLength": 1, "maxLength": 512},
          "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    {
      "if": {
        "properties": {"hand_detection_state": {"const": "FAILED"}}
      },
      "then": {
        "required": ["ai_job_id", "model_sha256", "profile_sha256"],
        "properties": {
          "ai_job_id": {"type": "string", "format": "uuid"},
          "candidate_count": {"const": 0},
          "candidate_artifact_ref": {"type": "null"},
          "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  ]
}
