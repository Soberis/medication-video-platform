{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.medication-video-platform.invalid/external-video-ingest-v2.schema.json",
  "title": "External Video Ingest Manifest V2",
  "description": "Versioned external capture-group manifest. Video declarations may arrive incrementally until upload_set_finalized is true; finalization is an explicit upstream fact and is never inferred from timeout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_system",
    "source_device_id",
    "capture_group",
    "videos",
    "upload_set_finalized"
  ],
  "properties": {
    "schema_version": {
      "const": "external-video-ingest-v2"
    },
    "source_system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "source_device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "source_batch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "capture_group": {
      "$ref": "#/$defs/captureGroup"
    },
    "videos": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/video"
      },
      "description": "The currently received explicit video declarations. It may be a strict subset of expected_camera_numbers until finalization."
    },
    "upload_set_finalized": {
      "type": "boolean",
      "description": "Explicit upstream close signal. false keeps the receipt RECEIVING; true closes it as COMPLETE or INCOMPLETE based only on received camera numbers."
    }
  },
  "$defs": {
    "captureGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_group_key",
        "key_source",
        "captured_at",
        "timezone",
        "expected_camera_numbers"
      ],
      "properties": {
        "capture_group_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "description": "Stable upstream group identity. It is never inferred from filename, timing or upload order."
        },
        "key_source": {
          "type": "string",
          "enum": ["EXTERNAL_CAPTURE_SESSION_ID", "UPSTREAM_MANIFEST_KEY"]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "description": "Upstream capture declaration; it is not used to infer camera identity or group membership."
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_+./:-]{0,63}$"
        },
        "expected_camera_numbers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "description": "Stable display numbers. A missing expected number remains missing and is never renumbered."
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_file_id",
        "camera_number",
        "file_name",
        "declared_size_bytes",
        "sha256"
      ],
      "properties": {
        "client_file_id": {
          "type": "string",
          "format": "uuid"
        },
        "camera_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "Stable camera number. A camera can be declared once; a retry must retain the same digest and file facts."
        },
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "declared_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "record_start_at": {
          "type": "string",
          "format": "date-time",
          "description": "Optional upstream stream-start declaration. It is not a camera identity key and is not grouped by time proximity."
        }
      }
    }
  }
}
