{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.medication-video-platform.invalid/external-video-ingest-v1.schema.json",
  "title": "External Video Ingest Manifest V1",
  "description": "Cloud-side ingest manifest submitted by an external hospital edge or capture system. It does not authorize or expose edge-device control.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_system",
    "source_device_id",
    "capture_group",
    "videos"
  ],
  "properties": {
    "schema_version": {
      "const": "external-video-ingest-v1"
    },
    "source_system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "source_device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "source_batch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "capture_group": {
      "$ref": "#/$defs/captureGroup"
    },
    "videos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/video"
      }
    }
  },
  "$defs": {
    "captureGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_group_key",
        "key_source",
        "captured_at",
        "timezone",
        "expected_camera_numbers"
      ],
      "properties": {
        "capture_group_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "description": "Stable upstream group identity. It is never inferred from filename, timing or upload order."
        },
        "key_source": {
          "type": "string",
          "enum": ["EXTERNAL_CAPTURE_SESSION_ID", "UPSTREAM_MANIFEST_KEY"]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_+./:-]{0,63}$"
        },
        "expected_camera_numbers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "description": "Stable display numbers. A missing expected number remains missing and is never renumbered."
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_file_id",
        "camera_number",
        "file_name",
        "declared_size_bytes",
        "sha256"
      ],
      "properties": {
        "client_file_id": {
          "type": "string",
          "format": "uuid"
        },
        "camera_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "The server verifies that this number belongs to expected_camera_numbers and is unique within capture_group_key."
        },
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "declared_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "record_start_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
