{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medication-video-platform.local/contracts/events/media-probe-job-v1.schema.json",
  "title": "MediaProbeJobV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "job_id",
    "job_type",
    "attempt",
    "lease_token",
    "project_id",
    "clip_asset_id",
    "input_sha256",
    "input_size_bytes",
    "content_type",
    "probe_profile_key",
    "recipe_digest",
    "requested_at"
  ],
  "properties": {
    "schema_version": { "const": "media-probe-job.v1" },
    "message_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "job_type": { "const": "MEDIA_PROBE" },
    "attempt": { "type": "integer", "minimum": 1 },
    "lease_token": {
      "type": "string",
      "minLength": 43,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "project_id": { "type": "string", "format": "uuid" },
    "clip_asset_id": { "type": "string", "format": "uuid" },
    "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input_size_bytes": { "type": "integer", "minimum": 1 },
    "content_type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$"
    },
    "probe_profile_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "recipe_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
