{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medication-video-platform.local/contracts/events/ai-hand-pose-result-v2.schema.json",
  "title": "AI Hand Pose Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "message_id", "job_id", "attempt", "lease_token", "input_sha256",
    "model_sha256", "profile_sha256", "started_at", "completed_at", "outcome",
    "analysis_complete", "hand_result", "total_video_frames", "inference_frame_count",
    "frames_with_hand", "frames_without_hand", "left_hand_detection_count",
    "right_hand_detection_count", "invalid_landmark_count", "processing_duration_ms", "failure_reason", "candidates"
  ],
  "properties": {
    "schema_version": { "const": "ai-hand-pose-result.v2" },
    "message_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "attempt": { "type": "integer", "minimum": 1 },
    "lease_token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$" },
    "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profile_sha256": { "const": "3a3be8035ec8a9756a32f43b007a4bb2cc2e2c0468d744d248f19c692fd90626" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "outcome": { "enum": ["SUCCEEDED", "FAILED"] },
    "analysis_complete": { "type": "boolean" },
    "hand_result": { "enum": ["UNKNOWN", "HAND_DETECTED", "NO_HAND_DETECTED"] },
    "total_video_frames": { "type": "integer", "minimum": 0 },
    "inference_frame_count": { "type": "integer", "minimum": 0 },
    "frames_with_hand": { "type": "integer", "minimum": 0 },
    "frames_without_hand": { "type": "integer", "minimum": 0 },
    "left_hand_detection_count": { "type": "integer", "minimum": 0 },
    "right_hand_detection_count": { "type": "integer", "minimum": 0 },
    "invalid_landmark_count": { "type": "integer", "minimum": 0 },
    "processing_duration_ms": { "type": "integer", "minimum": 0 },
    "failure_reason": { "type": ["string", "null"], "maxLength": 128 },
    "candidates": {
      "type": "array",
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_timestamp_ms", "image_width", "image_height", "hand_index", "handedness",
        "handedness_score", "bounding_box", "landmarks", "valid_landmark_count"
      ],
      "properties": {
        "frame_timestamp_ms": { "type": "integer", "minimum": 0 },
        "image_width": { "type": "integer", "minimum": 1 },
        "image_height": { "type": "integer", "minimum": 1 },
        "hand_index": { "type": "integer", "minimum": 0, "maximum": 1 },
        "handedness": { "enum": ["LEFT", "RIGHT", "UNKNOWN"] },
        "handedness_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "bounding_box": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "landmarks": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "z"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "z": { "type": "number" }
            }
          }
        },
        "valid_landmark_count": { "type": "integer", "const": 21 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "SUCCEEDED" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "analysis_complete": { "const": true },
          "total_video_frames": { "minimum": 1 },
          "inference_frame_count": { "minimum": 1 },
          "hand_result": { "enum": ["HAND_DETECTED", "NO_HAND_DETECTED"] },
          "failure_reason": { "type": "null" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "hand_result": { "const": "NO_HAND_DETECTED" } },
              "required": ["hand_result"]
            },
            "then": {
              "properties": {
                "frames_with_hand": { "const": 0 },
                "frames_without_hand": { "minimum": 1 },
                "left_hand_detection_count": { "const": 0 },
                "right_hand_detection_count": { "const": 0 },
                "invalid_landmark_count": { "const": 0 },
                "candidates": { "maxItems": 0 }
              }
            }
          },
          {
            "if": {
              "properties": { "hand_result": { "const": "HAND_DETECTED" } },
              "required": ["hand_result"]
            },
            "then": {
              "properties": {
                "frames_with_hand": { "minimum": 1 },
                "invalid_landmark_count": { "const": 0 },
                "candidates": { "minItems": 1 }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "FAILED" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "analysis_complete": { "const": false },
          "hand_result": { "const": "UNKNOWN" },
          "failure_reason": { "type": "string", "minLength": 1 },
          "candidates": { "maxItems": 0 }
        }
      }
    }
  ]
}
