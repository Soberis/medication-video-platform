{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medication-video-platform.invalid/schemas/mediapipe-hand-landmarker-benchmark-input.v1.json",
  "title": "MediaPipe hand-landmarker benchmark input",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance", "frames"],
  "properties": {
    "format": {"const": "mediapipe-hand-landmarker-benchmark-input.v1"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frame"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_sha256", "profile", "profile_sha256", "fps", "threshold", "dataset_version", "dataset_digest", "evaluation_code_version", "timestamp", "dataset_kind", "authorization_reference"],
      "properties": {
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "profile": {"$ref": "#/$defs/identifier"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "dataset_version": {"$ref": "#/$defs/identifier"},
        "dataset_digest": {"$ref": "#/$defs/sha256"},
        "evaluation_code_version": {"$ref": "#/$defs/identifier"},
        "timestamp": {"type": "string", "format": "date-time"},
        "dataset_kind": {"enum": ["SYNTHETIC", "AUTHORIZED_EXTERNAL"]},
        "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "point": {
      "oneOf": [
        {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
        {"type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}}
      ]
    },
    "hand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hand_id", "handedness", "landmarks"],
      "properties": {
        "hand_id": {"$ref": "#/$defs/identifier"},
        "handedness": {"enum": ["LEFT", "RIGHT", "UNKNOWN"]},
        "normalization_scale": {"type": "number", "exclusiveMinimum": 0},
        "landmarks": {"type": "array", "minItems": 21, "maxItems": 21, "items": {"$ref": "#/$defs/point"}}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "timestamp_ms", "ground_truth_hands", "predicted_hands"],
      "properties": {
        "frame_id": {"$ref": "#/$defs/identifier"},
        "timestamp_ms": {"type": "number", "minimum": 0},
        "groups": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "additionalProperties": {"type": ["string", "boolean", "number"]}},
        "ground_truth_hands": {"type": "array", "maxItems": 2, "items": {"allOf": [{"$ref": "#/$defs/hand"}, {"required": ["normalization_scale"]}]}},
        "predicted_hands": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/hand"}}
      }
    }
  }
}
