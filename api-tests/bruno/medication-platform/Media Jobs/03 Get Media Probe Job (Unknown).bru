meta {
  name: Get Media Probe Job (Unknown)
  type: http
  seq: 3
  tags: [
    MediaJobs
  ]
}

get {
  url: {{baseUrl}}/api/v1/media-jobs/99999999-9999-9999-9999-999999999999
  body: none
  auth: inherit
}

tests {
  test("returns 404 with stable MEDIA_JOB_NOT_FOUND", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(404);
    expect(body.error_code).to.equal("MEDIA_JOB_NOT_FOUND");
    expect(body.retryable).to.equal(false);
  });
}
