meta {
  name: Get Media Report (Unknown)
  type: http
  seq: 4
  tags: [
    MediaJobs
  ]
}

get {
  url: {{baseUrl}}/api/v1/media-jobs/99999999-9999-9999-9999-999999999999/report
  body: none
  auth: inherit
}

tests {
  test("returns 404 without exposing cross-project report state", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(404);
    expect(body.error_code).to.equal("MEDIA_JOB_NOT_FOUND");
    expect(body.retryable).to.equal(false);
  });
}
