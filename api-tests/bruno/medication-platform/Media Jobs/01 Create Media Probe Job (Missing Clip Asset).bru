meta {
  name: Create Media Probe Job (Missing Clip Asset)
  type: http
  seq: 1
  tags: [
    MediaJobs
  ]
}

post {
  url: {{baseUrl}}/api/v1/media-jobs
  body: json
  auth: inherit
  headers {
    Idempotency-Key: bruno-media-probe-missing-1234567890
  }
}

body:json {
  {
    "clipAssetId": "99999999-9999-9999-9999-999999999999",
    "jobType": "MEDIA_PROBE"
  }
}

tests {
  test("rejects unknown clip asset with stable CLIP_ASSET_NOT_FOUND", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(404);
    expect(body.error_code).to.equal("CLIP_ASSET_NOT_FOUND");
    expect(body.retryable).to.equal(false);
    expect(body.request_id).to.be.a("string").and.not.empty;
  });
}
