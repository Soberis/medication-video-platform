meta {
  name: Reject Missing Export Worker Identity
  type: http
  seq: 1
  tags: [
    DatasetExports
  ]
}

post {
  url: {{baseUrl}}/api/v1/internal/dataset-exports/99999999-9999-9999-9999-999999999999/attempts/1/lease
  body: none
  auth: none
}

tests {
  test("rejects a missing Export Worker service identity before reading an attempt", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("cache-control")).to.equal("no-store");
    expect(res.getHeader("www-authenticate")).to.equal("Bearer");
    expect(body.error_code).to.equal("UNAUTHORIZED");
    expect(body.retryable).to.equal(false);
    expect(body.request_id).to.be.a("string").and.not.empty;
  });
}
