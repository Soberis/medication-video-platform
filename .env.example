# Local development placeholders only. Never place production credentials here.
COMPOSE_PROJECT_NAME=medication-video-platform

POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=medication_platform
POSTGRES_USER=medication_local
POSTGRES_PASSWORD=change-me-local-only

# Synthetic local API identity only. Never reuse hospital or production credentials.
DEV_BEARER_TOKEN=synthetic-local-bearer-token-do-not-reuse
DEV_ADMIN_BEARER_TOKEN=synthetic-local-admin-bearer-token-do-not-reuse
DEV_PROJECT_ID=00000000-0000-0000-0000-000000000001
# Creates only the reserved local synthetic project and its two test identities; ignored outside the local profile.
LOCAL_SYNTHETIC_PROJECT_ENABLED=true
# Local platform administrator bootstrap. Set both values in an untracked .env file;
# do not use hospital, production, or personal credentials.
PLATFORM_BOOTSTRAP_ADMIN_USERNAME=
PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=
PLATFORM_SESSION_COOKIE_SECURE=false
UPLOAD_BATCH_TTL=PT24H
UPLOAD_PART_AUTHORIZATION_TTL=PT15M
# Destructive object cleanup stays off until the environment operator explicitly approves it.
UPLOAD_CLEANUP_ENABLED=false
UPLOAD_CLEANUP_POLL_DELAY=PT30S
UPLOAD_EXPIRY_BATCH_SIZE=20
UPLOAD_CLEANUP_BATCH_SIZE=20
UPLOAD_CLEANUP_CLAIM_DURATION=PT1M
UPLOAD_CLEANUP_RETRY_DELAY=PT30S
UPLOAD_CLEANUP_MAX_ATTEMPTS=5
# Detection stays active even while destructive cleanup is disabled. Reapprove the age threshold per environment.
UPLOAD_CLEANUP_ALERT_ENABLED=true
UPLOAD_CLEANUP_ALERT_POLL_DELAY=PT30S
UPLOAD_CLEANUP_ALERT_PENDING_AGE=PT5M
SPRING_PROFILES_ACTIVE=local

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=medication-platform-local
S3_ACCESS_KEY=change-me-local-only
S3_SECRET_KEY=change-me-local-only
S3_PORT=9000
S3_PATH_STYLE_ACCESS=true

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=medication_local
RABBITMQ_PASSWORD=change-me-local-only
RABBITMQ_VHOST=medication
PLATFORM_MESSAGING_RELAY_ENABLED=true

# Synthetic local Worker service identity only. Never reuse outside local development.
MEDIA_WORKER_BEARER_TOKEN=local-media-worker-bearer-token-do-not-reuse
PLATFORM_API_BASE_URL=http://localhost:8080
MEDIA_WORKER_ID=media-worker-local-1
RABBITMQ_URL=amqp://medication_local:change-me-local-only@127.0.0.1:5672/medication
MEDIA_PROBE_TIMEOUT_SECONDS=1800
MEDIA_PROBE_LEASE_DURATION=PT30M
MEDIA_PROBE_HEARTBEAT_INTERVAL=PT5M
MEDIA_PROBE_LEASE_GRACE=PT5M
MEDIA_PROBE_MAX_ATTEMPTS=3
MEDIA_PROBE_MAX_MANUAL_REPLAYS=2
MEDIA_PROBE_RETRY_BASE_DELAY=PT5S
MEDIA_PROBE_RETRY_MAX_DELAY=PT5M
MEDIA_PROBE_RECOVERY_POLL_DELAY=PT30S
MEDIA_PROBE_RECOVERY_BATCH_SIZE=20
MEDIA_INPUT_AUTHORIZATION_TTL=PT15M
MEDIA_RESULT_CLOCK_SKEW=PT5M
MEDIA_WORKER_APPROVED_SOFTWARE_DIGEST=sha256:201b949e19d413488d2f5458971586d8bc049ae4d5c84b8ec09af71a81340def

# Hand-pose analysis remains disabled until its offline model, persisted camera setting and written GO are configured.
AI_HAND_POSE_ENABLED=false
AI_HAND_POSE_MODEL_PATH=
AI_HAND_POSE_MODEL_SHA256=
AI_WORKER_BEARER_TOKEN=
# Optional absolute file path; configure this instead of AI_WORKER_BEARER_TOKEN for a file-backed AI Worker identity.
AI_WORKER_BEARER_TOKEN_FILE=
AI_WORKER_ID=ai-worker-local-1

PLATFORM_API_PORT=8080
WEB_PORT=5173

# Must remain synthetic-only in local development.
DATA_PROFILE=synthetic
