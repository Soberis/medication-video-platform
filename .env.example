S3_PATH_STYLE_ACCESS=true

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=medication_local
RABBITMQ_PASSWORD=change-me-local-only
